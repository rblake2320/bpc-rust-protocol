# BPC Gateway configuration. Copy to a mode-600 file outside source control.
# `serve` does not run database migrations and starts closed if Redis replay
# continuity has not been provisioned and reconciled.

# development permits only literal loopback PostgreSQL/Redis with explicit opt-in.
# production requires TLS-verified PostgreSQL URLs and a Redis TLS endpoint.
BPC_GATEWAY_MODE=production
BPC_GATEWAY_BIND_ADDR=0.0.0.0:8080
BPC_GATEWAY_AUDIENCE=bpc://api.example.com/production
BPC_GATEWAY_SIGNATURE_WINDOW_MS=60000
BPC_GATEWAY_MAX_BODY_BYTES=1048576
BPC_GATEWAY_MAX_BODY_IN_FLIGHT=32
BPC_GATEWAY_MAX_VERIFICATIONS=32

# Pair authority: PostgreSQL URL must include sslmode=verify-full in production.
BPC_GATEWAY_POSTGRES_URL='postgresql://bpc_runtime:REDACTED@authority-db.example.com/bpc?sslmode=verify-full'
BPC_GATEWAY_POSTGRES_SCHEMA=bpc

# Exactly 32 random bytes, base64url unpadded, obtained from your KMS/secret manager.
BPC_GATEWAY_DATA_KEY_ID=bpc-prod-2026-01
BPC_GATEWAY_DATA_KEY_B64=REPLACE_WITH_KMS_UNWRAPPED_32_BYTE_BASE64URL_KEY

# Dedicated Redis deployment. Production uses rediss and waits for a replica acknowledgement.
BPC_GATEWAY_REDIS_URL='rediss://:REDACTED@replay-redis.example.com:6380/0'
BPC_GATEWAY_REDIS_NAMESPACE=bpc-production
BPC_GATEWAY_REDIS_MIN_REPLICA_ACKS=1
BPC_GATEWAY_ALLOW_INSECURE_LOOPBACK=false

# A different, independently backed-up PostgreSQL deployment for the linear
# replay-continuity anchor. It must not share Redis's restore domain.
BPC_GATEWAY_ANCHOR_POSTGRES_URL='postgresql://bpc_anchor:REDACTED@continuity-db.example.com/bpc_anchor?sslmode=verify-full'
BPC_GATEWAY_ANCHOR_SCHEMA=bpc_anchor
